# Your providers' test keys: copy to .env (git-ignored), fill in what you have.
# A provider is configured once every key its README calls for is set; the
# others stay listed as "not configured" by `docker compose run --rm omnitrade gateways`.

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNITRADE_PLUGINS=../..

# Where a hosted page sends the buyer back (any URL will do to read the result by hand).
HARNESS_RETURN_URL=https://example.org/paid
HARNESS_CANCEL_URL=https://example.org/cancelled
HARNESS_CUSTOMER_EMAIL=buyer@example.org
HARNESS_CUSTOMER_NAME="Émile Zola"
# A product page for `bare` to read through omnitrade/web (any shop's; empty: none is read).
HARNESS_PRODUCT_URL=

# Stripe (test keys: sk_test_..., whsec_... from the Stripe CLI or the dashboard's webhook)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADAPTIVE_PRICING=0
# PayPal (a sandbox REST app)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=1
# Shopify (a development store's custom app: Admin API token, webhook secret)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=
# The catalogue's prices' currency; empty: the shop's own (the app needs read_products, read_inventory)
SHOPIFY_CURRENCY=
# WooCommerce (REST API keys with read/write, the store's webhook secret)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
# The store's currency and weight unit, for the catalogue (empty: EUR, kg)
WOOCOMMERCE_CURRENCY=
WOOCOMMERCE_WEIGHT_UNIT=
# Web: nothing needed. Affiliate parameters by host, "amazon.fr:tag=mysite-21,fnac.com:awc=1_2"
WEB_AFFILIATE=
# Amazon (Associates partner tag; the Creators API credentials when the account is eligible; 3.1 NA, 3.2 EU, 3.3 FE)
AMAZON_PARTNER_TAG=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_MARKETPLACE=www.amazon.fr
AMAZON_CREDENTIAL_VERSION=3.2
