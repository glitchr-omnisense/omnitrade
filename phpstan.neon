# PHPStan at the highest level, as the family's harness runs it (docker compose run --rm omnitrade
# phpstan, in omnisense/omnitrade's docker/). phpstan-baseline.neon holds what was there when
# PHPStan came in (2026-11-10): it may only shrink.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
    # The bundle names every provider's factory (OmnitradeBundle::FACTORIES) and registers those installed.
    # Installed alone (this package's CI), they are unknown classes; with every provider (the family's
    # harness), PHPStan knows them. Both hold.
    ignoreErrors:
        -
            identifier: class.notFound
            path: Bridge/Symfony/OmnitradeBundle.php
            reportUnmatched: false
